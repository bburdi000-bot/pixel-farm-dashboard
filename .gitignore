# Live operational state NEVER gets committed. The only model in this repo is
# the synthetic one in data/, generated by tools/make-demo.js.
#
# The real derive layer writes farm-model.json next to the page so the same
# index.html can be served locally against real data. CI fails the build if any
# of these ever become tracked (see .github/workflows/ci.yml, "no live model").
farm-model.json
farm-model.*.json
*.local.json
/data/farm-live*.json

# the private derive layer itself, if it is ever copied in here to run
build-real.js

.DS_Store
node_modules/

# pixedit scratch: PNGs are a working form, row strings are the source of truth
.pixedit/
